# ---------------------------------------------------------------------------
# Network. 1328 = Atlantic-2 testnet, 1329 = Pacific-1 mainnet.
# ---------------------------------------------------------------------------
SEI_CHAIN_ID=1328
SEI_RPC_URL=https://evm-rpc-testnet.sei-apis.com
# App commands block remote Pacific-1 writes unless this is explicitly set to 1.
ALLOW_MAINNET=0

# ---------------------------------------------------------------------------
# The single funded trading account. Holds all inventory and signs every
# UserOperation. Gets EIP-7702 delegated once, then its EVM nonce never moves
# again on the trading path.
#
# Use a fresh throwaway key. Fund it from https://docs.sei.io/learn/faucet
# The value must be a non-zero 32-byte hex private key.
# ---------------------------------------------------------------------------
TRADER_PRIVATE_KEY=0x

# ---------------------------------------------------------------------------
# Gas-only submitters, derived from this mnemonic at addressIndex 0..N-1.
# These never hold trading inventory. A compromised relayer can lose its own gas
# balance or submit UserOperations the trader already signed, but cannot create
# a new trader-authorized operation.
#
# Generate one with:  cast wallet new-mnemonic
# Never put the public Anvil/Hardhat mnemonic here for a remote RPC.
# ---------------------------------------------------------------------------
RELAYER_MNEMONIC=
RELAYER_COUNT=4
# Offset the derivation path if this mnemonic also holds the trading key.
RELAYER_START_INDEX=0
RELAYER_FUNDING=0.5
ENTRYPOINT_DEPOSIT=1

# ---------------------------------------------------------------------------
# Filled in by: forge script script/Deploy.s.sol --broadcast ...
# ---------------------------------------------------------------------------
LANE_ACCOUNT_IMPL=
VENUE=

# ---------------------------------------------------------------------------
# Run shape.
#
# LANE_POOL_SIZE caps in-flight operations: one lane holds at most one in-flight
# op, since ops sharing a lane are ordered relative to each other.
#
# MAX_OPS_PER_BUNDLE trades isolation for gas. A bundle is a shared failure
# domain for *validation* errors (bad signature, stale nonce, thin prefund), so
# set it to 1 for maximum isolation and higher for cheaper gas per op.
#
# REVERT_ORDER_INDEX gives one order an unfillable limit price so you can watch
# a failure land without disturbing its neighbors. Set to -1 to disable.
# (The old name SABOTAGE_INDEX still works but prints a deprecation warning.)
#
# ORDERS must be <= LANE_POOL_SIZE. Counts and gas values must be positive
# integers; REPLACEMENT_FEE_BUMP_PERCENT must be at least 10.
# ---------------------------------------------------------------------------
ORDERS=24
LANE_POOL_SIZE=32
MAX_OPS_PER_BUNDLE=4
REVERT_ORDER_INDEX=2

VERIFICATION_GAS_LIMIT=150000
PRE_VERIFICATION_GAS=60000

# CALL_GAS_LIMIT is a floor, and leaving it unset is usually right: both submit
# paths measure the real call gas for this chain and shape and add 25%. The
# EntryPoint reserves the declared limit before running an operation, so a value
# above the measurement costs block gas limit, and therefore operations per
# block, without changing the gas actually used.
# CALL_GAS_LIMIT=500000

# Outer handleOps transaction recovery. Each retry replaces the same relayer
# nonce, so an evicted transaction cannot leave a nonce gap. The attempt budget
# resets when a journaled bundle is recovered by a new process.
BUNDLE_RECEIPT_TIMEOUT_MS=12000
BUNDLE_MAX_ATTEMPTS=3
REPLACEMENT_FEE_BUMP_PERCENT=25

# How often to poll for a receipt. Sei's blocks are far shorter than viem's 4s
# default, which would otherwise spend most of BUNDLE_RECEIPT_TIMEOUT_MS waiting
# between polls and report timeouts for bundles that already landed.
RECEIPT_POLLING_INTERVAL_MS=250

# Signed UserOperations and raw outer transactions are persisted here before
# broadcast. Treat the journal as sensitive until its nonces are consumed.
# The default is app/.state/pending-ops.json.
# OPERATION_JOURNAL_PATH=/absolute/path/to/pending-ops.json

# All lane-based workflows for this trader share a separate process lock, even
# when they use different journals.
# SENDER_RUN_LOCK_PATH=/absolute/path/to/trader-run.lock

# ---------------------------------------------------------------------------
# Optional Atlantic-2 DragonSwap V1 native SEI/native USDC load test.
#
# `npm run swap:setup` creates and seeds the documented testnet pair if it does
# not exist. Get official testnet USDC from https://faucet.circle.com first.
# `npm run swap:submit` alternates both directions and reuses ORDERS,
# LANE_POOL_SIZE, MAX_OPS_PER_BUNDLE, and REVERT_ORDER_INDEX above.
# ---------------------------------------------------------------------------
SWAP_SEI_AMOUNT=0.0001
SWAP_USDC_AMOUNT=0.0001
SWAP_LIQUIDITY_SEI=100
SWAP_LIQUIDITY_USDC=100
SWAP_RETAINED_USDC_ALLOWANCE=10
SWAP_SLIPPAGE_BPS=500
SWAP_DEADLINE_SECONDS=7200

# Real swaps use a separate durable journal from the mock-venue demo.
# SWAP_OPERATION_JOURNAL_PATH=/absolute/path/to/pending-swaps.json
