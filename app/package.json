{
  "name": "sei-nonce-lanes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Concurrent transaction submission from one funded Sei EOA, using ERC-4337 nonce lanes and EIP-7702 delegation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sei-protocol/sei-nonce-lanes.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/sei-protocol/sei-nonce-lanes/issues"
  },
  "homepage": "https://github.com/sei-protocol/sei-nonce-lanes#readme",
  "keywords": [
    "sei",
    "erc-4337",
    "eip-7702",
    "nonce",
    "account-abstraction",
    "entrypoint",
    "relayer",
    "bundler"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "status": "tsx src/status.ts",
    "delegate": "tsx src/delegate.ts",
    "fund": "tsx src/fund.ts",
    "dispense": "tsx src/dispense.ts",
    "submit": "tsx src/submit.ts",
    "spray": "npm run submit",
    "swap:setup": "tsx src/swap-setup.ts",
    "swap:submit": "tsx src/swap-submit.ts",
    "swap:spray": "npm run swap:submit",
    "baseline": "tsx src/baseline.ts",
    "bench:lanes": "tsx bench/lanes-tps.ts",
    "bench:baseline": "tsx bench/baseline-tps.ts",
    "bench:sweep": "bench/sweep.sh",
    "bench:report": "tsx bench/block-report.ts",
    "bench:latency": "tsx bench/rpc-latency.ts",
    "diagram": "node scripts/diagram.mjs",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "dotenv": "^17.4.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "roughjs": "^4.6.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
