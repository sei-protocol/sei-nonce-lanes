{
  "name": "sei-parallel-nonce-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private ERC-4337 mempool and relayer pool for parallel-nonce submission on Sei",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "status": "tsx src/status.ts",
    "delegate": "tsx src/delegate.ts",
    "fund": "tsx src/fund.ts",
    "dispense": "tsx src/dispense.ts",
    "spray": "tsx src/spray.ts",
    "baseline": "tsx src/baseline.ts",
    "diagram": "node scripts/diagram.mjs",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "dotenv": "^17.4.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "roughjs": "^4.6.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
